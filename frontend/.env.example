# Copy to .env.local for local overrides. Vite only exposes VITE_-prefixed vars
# to client code - never put a secret here, it ships in the bundle.

# Backend base URL. Defaults to /api, which the Vite dev server proxies to
# http://127.0.0.1:8000 (see vite.config.ts). Set this to an absolute URL when
# the frontend is deployed separately from the backend.
VITE_API_BASE_URL=/api
