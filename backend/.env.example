########
## Server & Environment Settings
########

APP_ENV=local
APP_LOG_LEVEL=INFO
APP_LOG_JSON=false

########
## Allowed CORS browser origins
########
APP_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000","http://192.168.1.4:5173","http://192.168.1.4:3000"]


########
## LLM Providers (OpenRouter is primary; Anthropic/OpenAI optional)
########

# OpenRouter API Key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# OpenRouter Model Selection
OPENROUTER_MODEL=openrouter/anthropic/claude-3.5-sonnet

# Optional direct provider keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=


########
## Razorpay Test Mode & Webhook Credentials
########

# Razorpay API Key ID (rzp_test_...)
RAZORPAY_KEY_ID=

# Razorpay Key Secret
RAZORPAY_KEY_SECRET=

# Razorpay Webhook Secret for HMAC-SHA256 signature verification
RAZORPAY_WEBHOOK_SECRET=

# Partner/OAuth token + account id to fetch the linked merchant profile.
# Leave empty in test mode; the Integrations screen skips the live fetch.
RAZORPAY_ACCESS_TOKEN=
RAZORPAY_ACCOUNT_ID=


########
## Litellm Operational Configuration
########

LITELLM_MODE=PRODUCTION

# Divides intervention delays for fleet/simulation cases so the queue visibly
# drains during a demo. 1 keeps real timings (4h bank cutoff, 48h salary cycle).
APP_FLEET_TIME_COMPRESSION=240

# Razorpay Technology Partner OAuth. Whitelist <APP_PUBLIC_BASE_URL>/api/integrations/oauth/callback
# on the Partner Dashboard app, or the Integrations screen shows setup steps instead of a connect button.
RAZORPAY_OAUTH_CLIENT_ID=
RAZORPAY_OAUTH_CLIENT_SECRET=
RAZORPAY_OAUTH_MODE=test

# Public origin of the dashboard, used to redirect back after the OAuth callback.
APP_PUBLIC_BASE_URL=http://127.0.0.1:5173

# Twilio Voice (outbound Hinglish recovery calls). All three required or the
# voice channel fails closed instead of faking a call.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Sarvam AI TTS (pre-generates the voice call's Hinglish audio; falls back
# to Twilio's own <Say> when unset).
SARVAM_API_KEY=
SARVAM_TTS_SPEAKER=shubh

# Generic outbound-notification relay (SMS/email fallback, and WhatsApp when
# the Cloud API below is not configured). Points at a merchant-run relay
# service; unset means notifications simulate rather than send.
NOTIFICATION_WEBHOOK_URL=

# Meta WhatsApp Business Cloud API (real outbound template messages). All
# three required or the WhatsApp channel falls back to NOTIFICATION_WEBHOOK_URL.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_TOKEN=
WHATSAPP_TEMPLATE_NAME=

# Operator sign-in. Defaults to placeholder password "admin" when unset -- change
# before going live. Set a session secret too, or restarts sign everyone out.
APP_OPERATOR_PASSWORD=
APP_SESSION_SECRET=
APP_SESSION_TTL_HOURS=12
