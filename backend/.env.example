### ==============================================================================
### Server & Environment Settings
### ==============================================================================

APP_ENV=local
APP_LOG_LEVEL=INFO
APP_LOG_JSON=false

### Allowed CORS browser origins
APP_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000","http://192.168.1.4:5173","http://192.168.1.4:3000"]


### ==============================================================================
### LLM Providers (OpenRouter is primary; Anthropic/OpenAI optional)
### ==============================================================================

# OpenRouter API Key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# OpenRouter Model Selection
OPENROUTER_MODEL=openrouter/anthropic/claude-3.5-sonnet

# Optional direct provider keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=


### ==============================================================================
### Razorpay Test Mode & Webhook Credentials
### ==============================================================================

# Razorpay API Key ID (rzp_test_...)
RAZORPAY_KEY_ID=

# Razorpay Key Secret
RAZORPAY_KEY_SECRET=

# Razorpay Webhook Secret for HMAC-SHA256 signature verification
RAZORPAY_WEBHOOK_SECRET=

# Partner/OAuth access token and target account id used to fetch the linked
# merchant account profile (name/type/status) via GET /v2/accounts/:account_id.
# Leave empty in test mode; the Integrations screen then skips the live fetch.
RAZORPAY_ACCESS_TOKEN=
RAZORPAY_ACCOUNT_ID=


### ==============================================================================
### Litellm Operational Configuration
### ==============================================================================

LITELLM_MODE=PRODUCTION

# Divides intervention delays for fleet/simulation cases so the queue visibly
# drains during a demo. 1 keeps real timings (4h bank cutoff, 48h salary cycle).
APP_FLEET_TIME_COMPRESSION=240

# Razorpay Technology Partner OAuth. Register an application on the Partner
# Dashboard, then whitelist <APP_PUBLIC_BASE_URL>/api/integrations/oauth/callback
# on it. Without these the Integrations screen shows the prerequisites instead of
# a connect button.
RAZORPAY_OAUTH_CLIENT_ID=
RAZORPAY_OAUTH_CLIENT_SECRET=
RAZORPAY_OAUTH_MODE=test

# Public origin of the dashboard, used to redirect back after the OAuth callback.
APP_PUBLIC_BASE_URL=http://127.0.0.1:5173

# Operator sign-in. Leave the password blank to disable authentication entirely,
# which is the default for local development. Setting it puts the whole dashboard
# behind a login. Set a stable session secret or every restart signs operators out.
APP_OPERATOR_PASSWORD=
APP_SESSION_SECRET=
APP_SESSION_TTL_HOURS=12
