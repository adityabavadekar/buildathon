### ==============================================================================
### Server & Environment Settings
### ==============================================================================

APP_ENV=local
APP_LOG_LEVEL=INFO
APP_LOG_JSON=false

### Allowed CORS browser origins
APP_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000","http://192.168.1.4:5173","http://192.168.1.4:3000"]


### ==============================================================================
### LLM Providers (OpenRouter is primary; Anthropic/OpenAI optional)
### ==============================================================================

# OpenRouter API Key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# OpenRouter Model Selection
OPENROUTER_MODEL=openrouter/anthropic/claude-3.5-sonnet

# Optional direct provider keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=


### ==============================================================================
### Razorpay Test Mode & Webhook Credentials
### ==============================================================================

# Razorpay API Key ID (rzp_test_...)
RAZORPAY_KEY_ID=

# Razorpay Key Secret
RAZORPAY_KEY_SECRET=

# Razorpay Webhook Secret for HMAC-SHA256 signature verification
RAZORPAY_WEBHOOK_SECRET=


### ==============================================================================
### Litellm Operational Configuration
### ==============================================================================

LITELLM_MODE=PRODUCTION
