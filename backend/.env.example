# Copy to .env and fill in. .env is git-ignored - never commit real keys.

# ---- Service ----------------------------------------------------------------
APP_ENV=local                  # local | ci | production
APP_LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR
APP_LOG_JSON=false             # true in deployment, false locally for readability

# Comma-separated, or JSON array. Defaults to the Vite dev server.
APP_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ---- LLM providers ----------------------------------------------------------
# At least one is required once agent logic exists. Unset is fine for /health.
# These intentionally do NOT take the APP_ prefix.
ANTHROPIC_API_KEY=sk-ant-dummy-replace-me
OPENAI_API_KEY=sk-dummy-replace-me

# Silences litellm's implicit load_dotenv() and its debug chatter.
LITELLM_MODE=PRODUCTION
