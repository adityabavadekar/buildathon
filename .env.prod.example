# Copy to .env and fill in. Never commit the filled copy.
# Generate the two secrets with: openssl rand -hex 32

POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_strong_password
POSTGRES_DB=fortx

# Unset disables the login gate entirely and leaves the dashboard open.
APP_OPERATOR_PASSWORD=replace_with_the_operator_password
# Fixed value required: a random per-process key logs everyone out on restart.
APP_SESSION_SECRET=replace_with_openssl_rand_hex_32

APP_LOG_LEVEL=INFO
# JSON array. Must list the browser origin the dashboard is served from.
APP_CORS_ORIGINS=["http://localhost:3000"]
# Public origin used to build the Razorpay OAuth callback URL.
APP_PUBLIC_BASE_URL=http://localhost:3000
FRONTEND_PUBLISH_PORT=3000

APP_RAZORPAY_KEY_ID=
APP_RAZORPAY_KEY_SECRET=
APP_RAZORPAY_WEBHOOK_SECRET=
APP_RAZORPAY_OAUTH_CLIENT_ID=
APP_RAZORPAY_OAUTH_CLIENT_SECRET=

APP_GROQ_API_KEY=
APP_OPENROUTER_API_KEY=
APP_ANTHROPIC_API_KEY=

APP_NOTIFICATION_WEBHOOK_URL=
APP_WHATSAPP_API_TOKEN=
